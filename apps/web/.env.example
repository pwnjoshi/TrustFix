# TrustFix Web (Next.js) Environment Variables
# Copy to apps/web/.env.local for local development:
#   Copy-Item apps/web/.env.example apps/web/.env.local  (PowerShell)
#   cp apps/web/.env.example apps/web/.env.local         (Bash / macOS / Linux)

# URL of the running FastAPI backend
API_BASE_URL=http://localhost:8000

# Public browser origin for the Next.js frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication mode ('dev' simulates Google IAP headers locally)
TRUSTFIX_AUTH_MODE=dev

# Optional: Set to 'true' on marketing domain when proxying /app to workspace
TRUSTFIX_PUBLIC_SITE_MODE=false

# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# TrustFix server configuration (server-only unless marked public)
TRUSTFIX_ENV=development
TRUSTFIX_PLATFORM_PROJECT_ID=trustfix-506602
TRUSTFIX_TARGET_PROJECT_ID=trustfix-demo-target
GOOGLE_CLOUD_REGION=us-central1
TRUSTFIX_MODEL=gemini-3.5-flash
FIRESTORE_DATABASE=(default)
STORE_BACKEND=memory
PREVIEW_MODE=true
PUBSUB_SCAN_TOPIC=trustfix-scan-jobs
PUBSUB_REMEDIATION_TOPIC=trustfix-remediation-jobs

# Authentication (server-only)
AUTH_MODE=dev
TRUSTFIX_IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/REGION/services/WEB_SERVICE
TRUSTFIX_DEV_USER_EMAIL=owner@trustfix.local
API_BASE_URL=http://localhost:8080

# Public browser URL; OAuth secrets must never use a NEXT_PUBLIC variable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
